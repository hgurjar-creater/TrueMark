{
  "name": "truemark",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n app,review -c blue,magenta \"next dev\" \"tsx scripts/review-worker.ts\"",
    "build": "next build",
    "start": "next start",
    "start:worker": "tsx scripts/review-worker.ts",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "evaluate": "node scripts/evaluate-review.mjs"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1157.0",
    "@napi-rs/canvas": "0.1.80",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "diff": "^5.2.2",
    "jose": "^6.2.13",
    "mammoth": "^1.13.0",
    "next": "14.2.35",
    "pdf-parse": "^2.4.5",
    "react": "^18",
    "react-dom": "^18",
    "sharp": "^0.35.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/diff": "^5.2.3",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "concurrently": "^10.0.6",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
