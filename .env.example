# PostgreSQL connection string for hosted deployment (Vercel + Neon/Supabase).
# For local SQLite development this is: file:./dev.db
DATABASE_URL="file:./dev.db"

# Random string of at least 32 characters used to sign session JWTs.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="replace-me-with-a-random-64-char-string"

# Set a long one-time code only while provisioning the first Super Admin on a
# fresh production database. Remove it from deployment settings after setup.
SUPER_ADMIN_SETUP_SECRET=""

# Optional. When absent, the review pipeline uses the deterministic mock provider
# and image checks use local measurements only.
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-3.6-flash"

# Private creative storage. Local development writes outside public/ under .data.
# For hosted deployments, configure a private S3-compatible bucket (AWS S3 or R2).
# S3_BUCKET=""
# S3_REGION="us-east-1"
# S3_ENDPOINT=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# PRIVATE_ASSET_DIR=""

# Background review worker polling interval in milliseconds (default: 900).
# REVIEW_WORKER_POLL_MS="900"
